# ── 基础 ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# MongoDB：本地默认库，也可换 Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/xingyu_xinsheng

# 部署在 Nginx / 负载均衡之后时填写跳数；本地直连保持 0
TRUST_PROXY=0

# 允许跨域的前端地址，逗号分隔。留空表示只允许同源请求。
# 例如：http://localhost:5173,https://your-domain.example
CORS_ORIGINS=

# ── 隐私与审计 ───────────────────────────────────────────────────────
# 生产环境必须换成随机长字符串：openssl rand -hex 32
AUDIT_HMAC_SECRET=dev-only-change-me-to-a-long-random-string

# 是否允许 HttpOnly Cookie 以外再读取 X-Anonymous-Id 头（默认允许）。
# 前端若把匿名 ID 放 localStorage，会通过该请求头携带。
ALLOW_ANONYMOUS_HEADER=true

# 匿名 Cookie 的名称与有效期（天）
ANONYMOUS_COOKIE_NAME=xy_anonymous_id
ANONYMOUS_COOKIE_DAYS=365

# 生产环境默认 true。只在本地 HTTP 调试时设为 false；
# 正式部署必须走 HTTPS 并保持 true，否则 Cookie 可被明文截获。
COOKIE_SECURE=

# 审计日志保留天数（只存哈希，不存正文）
MODERATION_LOG_RETENTION_DAYS=180

# ── 限流（单实例内存版；多实例请换 Redis 存储）──────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_15MIN=300
RATE_LIMIT_WRITE_PER_10MIN=30
RATE_LIMIT_ANALYZE_PER_MIN=60
RATE_LIMIT_MAIL_PER_HOUR=20

# ── 可选：OpenAI 兼容大模型，用于“私密树洞”的安抚文字 ─────────────
# 不填则自动使用本地安全模板，不影响任何接口可用性。
# 三项要同时存在才启用；API_KEY 是 LLM_API_KEY 的别名，设一个即可。
LLM_BASE_URL=
LLM_API_KEY=
# API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=6500

# ── 危机支持信息（可按学校通知更新）────────────────────────────────
CAMPUS_COUNSELING_NAME=东南大学心理健康教育中心
CAMPUS_COUNSELING_PHONE=025-52090277
CAMPUS_24H_HOTLINE=15251760520
CAMPUS_COUNSELING_NOTE=九龙湖校区大学生活动中心4楼；四牌楼 025-83793744；丁家桥 025-83272273。预约方式以学校最新通知为准。

# ── 前端 ─────────────────────────────────────────────────────────────
# 默认直接托管仓库根目录的展示页；也可以改成 public/index.html
FRONTEND_FILE=./52-完整体-大字(1).html
