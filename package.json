{
  "name": "xingyu-xinsheng-backend",
  "version": "1.0.0",
  "private": true,
  "description": "星语心声 · 东南大学同校情绪共鸣空间后端（Express + MongoDB）",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-with-memory.js",
    "test": "node --test --test-concurrency=1 tests",
    "test:unit": "node --test tests/analyzer.test.js tests/date.test.js",
    "check": "node --check src/server.js && node --check src/app.js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.24.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.1.0"
  }
}
